    "def experiment_report(exp_data, freq_result, bayes_result, ground_truth=None):\n",
    "    \"\"\"Print a clean experiment report.\"\"\"\n",
    "    print(\"=\" * 60)\n",
    "    print(\"PRICING EXPERIMENT REPORT\")\n",
    "    print(\"Segment: europe_leisure | Test: −10% price reduction\")\n",
    "    print(\"=\" * 60)\n",
    "    print(f\"\\n📊 OBSERVED DATA\")\n",
    "    print(f\"  Control sessions:   {exp_data['n_control']:,}\")\n",
    "    print(f\"  Treatment sessions: {exp_data['n_treatment']:,}\")\n",
    "    print(f\"  Control CR:         {exp_data['observed_cr_control']:.2%}\")\n",
    "    print(f\"  Treatment CR:       {exp_data['observed_cr_treatment']:.2%}\")\n",
    "    print(f\"  Observed lift:      {(exp_data['observed_cr_treatment']/exp_data['observed_cr_control']-1):+.1%}\")\n",
    "    print(f\"\\n📈 FREQUENTIST RESULT\")\n",
    "    print(f\"  p-value:            {freq_result['p_value']:.4f}\")\n",
    "    print(f\"  95% CI on lift:     [{freq_result['ci_95_lo']:+.3f}, {freq_result['ci_95_hi']:+.3f}]\")\n",
    "    print(f\"  Significant:        {'Yes ✅' if freq_result['significant'] else 'No ❌'}\")\n",
    "    print(f\"\\n🎲 BAYESIAN RESULT\")\n",
    "    print(f\"  P(treatment > control): {bayes_result['prob_treatment_better']:.1%}\")\n",
    "    print(f\"  Expected loss (launch): {bayes_result['expected_loss_if_launch']:.5f}\")\n",
    "    print(f\"  Expected loss (rollback):{bayes_result['expected_loss_if_rollback']:.5f}\")\n",
    "    launch = bayes_result['expected_loss_if_launch'] < bayes_result['expected_loss_if_rollback']\n",
    "    print(f\"  Decision:           {'Launch treatment ✅' if launch else 'Keep control ❌'}\")\n",
    "    if ground_truth:\n",
    "        print(f\"\\n🔬 GROUND TRUTH (simulation only)\")\n",
    "        print(f\"  True lift:          {ground_truth['true_lift_relative']:+.0%}\")\n",
    "\n",
    "experiment_report(exp_data, freq_result, bayes_result, ground_truth)"
